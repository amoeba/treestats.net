!!! XML
%feed{:xmlns => 'http://www.w3.org/2005/Atom', 'xml:lang' => 'en', 'xml:base' => "#{NewsHelper::NEWS_BASE_URL}/"}
  %id= "#{NewsHelper::NEWS_BASE_URL}/news"
  %title TreeStats News
  %link{:rel => 'self', :type => 'application/atom+xml', :href => "#{NewsHelper::NEWS_BASE_URL}/news.atom"}
  %link{:rel => 'alternate', :type => 'text/html', :href => "#{NewsHelper::NEWS_BASE_URL}/news"}
  %updated= @feed_updated_at.utc.iso8601
  %author
    %name TreeStats
  - @posts.each do |post|
    - url = "#{NewsHelper::NEWS_BASE_URL}/news/#{post.slug}"
    %entry
      %id= url
      %title= post.title
      %link{:rel => 'alternate', :type => 'text/html', :href => url}
      %published= post.published_at.utc.iso8601
      %updated= (post.updated_at || post.published_at).utc.iso8601
      %content{:type => 'html'}= NewsMarkdown.render(post.body)
