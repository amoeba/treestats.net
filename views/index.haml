%h2.title Welcome to TreeStats!

-# Disabled in code until I cache this
-# %h3.subtitle= "#{AppHelper.add_commas(@total_uploads)} uploads and counting"

#dashboards
  %div
    %table.dashboard
      %thead
        %tr
          %th
            Population
            %span{"data-tippy-content" => "Updated every 5 minutes. Numbers only update when a player running the TreeStats Decal plugin logs in for the first time. Count includes all characters in the world not just those running TreeStats.", :class => "tippy"} ?

          %th{:colspan => 1}
            Server
          %th.gold= "(Total: #{@latest_counts.map { |p| p[:count]}.sum})"
      %tbody
        - @latest_counts.to_a.each do |pop|
          %tr
            %td= pop[:count]
            %td
              %a{:href => "/#{pop[:server]}"}= "#{pop[:server]}"
            %td= "as of #{AppHelper.relative_time(pop[:date])}"
    %div.right
      %a{:href => "/servers", :style => "color: rgba(255, 255, 255, 0.75); font-size: 80%; text-decoration: none"} → View All

  %table.dashboard
    %thead
      %tr
        %th
          Total Uploaded
          %span{"data-tippy-content" => "Just the number of characters from each server that have been uploaded to TreeStats. The number of characters on each server might be much higher.", :class => "tippy"} ?
        %th Server
    %tbody
      - @total_uploaded.each do |s|
        %tr
          %td= s["count"]
          %td
            %a{:href => "/#{s["_id"]}"}= "#{s["_id"] }"

  != haml :_dashboard_uploads_latest

%section.home-news{:"aria-label" => "News"}
  %table.dashboard.news-dashboard
    %thead
      %tr
        %th{:scope => "col"} News
    %tbody
      - if @news_posts.empty?
        %tr
          %td No news posts yet.
      - @news_posts.each do |post|
        %tr
          %td
            %a{:href => "/news/#{post.slug}"}= post.title
  %div.right
    %a{:href => "/news"} → View all news
